{
  "expo": {
    "name": "SpendProof",
    "slug": "spendproof",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "spendproof",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spendproof.app",
      "buildNumber": "1"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "SpendProof uses photos only when you choose quote images to check.",
          "cameraPermission": "SpendProof uses the camera only to photograph a quote you choose to check.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
