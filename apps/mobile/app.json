{
  "expo": {
    "name": "SpendProof",
    "slug": "spendproof",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "spendproof",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spendproof.app",
      "buildNumber": "1"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
